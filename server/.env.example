# Copy to server/.env and fill in.

PORT=3001
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=100

# Firebase Admin credentials. Set ONE of these:
#   the service account JSON inline...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
#   ...or a path to the JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# For a local demo with no Firebase project. Never set this in production.
ALLOW_UNAUTHENTICATED=true
