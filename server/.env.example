# Copy to server/.env. All of this is optional for local use — with no .env at
# all the API starts in demo mode (authentication skipped) and says so loudly.

PORT=3001
CORS_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=100

# Firebase Admin credentials. Set ONE of these to require real sign-in.
# Without them the API runs in demo mode, and refuses to start at all when
# NODE_ENV=production.
#
#   the service account JSON inline...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
#
#   ...or a path to the JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
